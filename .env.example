# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Your Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Your Application / Bot Client ID (Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Optional: Guild ID for instant local testing of slash commands
GUILD_ID=

# Gemini AI API Keys for Chatbot (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=your_backup_gemini_api_key_here
GEMINI_API_KEY_3=your_backup_gemini_api_key_here

# Dashboard Port (Default: 3000)
PORT=3000
